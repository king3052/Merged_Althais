# Copy this file to .env for local development. Never commit .env.
# Production values live in Railway (Project > Variables).
# Optional settings are commented out: an empty value would override the built-in default, so uncomment only what you set.

# --- Required ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./althais.db
APP_URL=http://localhost:8000
ADMIN_PASSWORD=change-me
GROQ_API_KEY=
# Keep the end-of-day claim batch off on your machine.
BILLING_JOBS_DISABLED=1

# --- Optional ---------------------------------------------------------------
# Admin console username (defaults in auth.py)
# ADMIN_USERNAME=

# Production only: send login cookies over HTTPS only
# COOKIE_SECURE=1

# Scan To Autofill (patient intake) uses Anthropic. See docs/PATIENT_INTAKE.md
# ANTHROPIC_API_KEY=
# INTAKE_MODEL=
# INTAKE_TIMEOUT_SECONDS=

# Model overrides for coding suggestions
# ALTHAIS_FAST_MODEL=
# ALTHAIS_BUILD_MODEL=

# Encryption keys for stored PHI and clearinghouse credentials (fall back to SECRET_KEY)
# PHI_ENC_KEY=
# CLEARINGHOUSE_ENC_KEY=

# Clearinghouse (Claim.MD). See docs/BILLING_ACTIVATION.md
# CLEARINGHOUSE_PARTNER=
# CLEARINGHOUSE_API_KEY=
# CLEARINGHOUSE_WEBHOOK_SECRET=
# BILLING_SANDBOX_ORGS=
# BILLING_BATCH_HOUR_UTC=

# Transactional email (Resend)
# RESEND_API_KEY=

# Design preview pages under /v4
# ALTHAIS_V4_PREVIEW=1

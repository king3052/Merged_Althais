# Copy this file to .env for local development. Never commit .env.
# Production values live in Railway (Project > Variables).
# Optional settings are commented out: an empty value would override the built-in default, so uncomment only what you set.

# --- Required ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./althais.db
APP_URL=http://localhost:8000
ADMIN_PASSWORD=change-me
GROQ_API_KEY=
# Keep the end-of-day claim batch off on your machine.
BILLING_JOBS_DISABLED=1

# --- Optional ---------------------------------------------------------------
# Admin console username (defaults in auth.py)
# ADMIN_USERNAME=

# Production only: send login cookies over HTTPS only
# COOKIE_SECURE=1

# Scan To Autofill (patient intake) uses Anthropic. See docs/PATIENT_INTAKE.md
# ANTHROPIC_API_KEY=
# INTAKE_MODEL=
# INTAKE_TIMEOUT_SECONDS=

# Model overrides for coding suggestions
# ALTHAIS_FAST_MODEL=
# ALTHAIS_BUILD_MODEL=

# Encryption keys (AES-256-GCM, see crypto_box.py). Each falls back to SECRET_KEY. Give each its own long random value
# in production, so changing SECRET_KEY (which signs people out) doesn't make stored data unreadable.
# PHI_ENC_KEY=            intake documents and their extracted data
# CLEARINGHOUSE_ENC_KEY=  clearinghouse and DrChrono connections
# TEBRA_ENC_KEY=          Tebra connections
# MFA_ENC_KEY=            two-step login secrets
# BROWSER_ENC_KEY=        each clinic's data kept in the browser (falls back to PHI_ENC_KEY). Changing it makes what's
#                         in browsers unreadable: patients and claims come back from the server, appointments and notes don't.

# Clearinghouse (Claim.MD). See docs/BILLING_ACTIVATION.md
# CLEARINGHOUSE_PARTNER=
# CLEARINGHOUSE_API_KEY=
# CLEARINGHOUSE_WEBHOOK_SECRET=
# BILLING_SANDBOX_ORGS=
# BILLING_BATCH_HOUR_UTC=

# Transactional email (Resend)
# RESEND_API_KEY=

# Design preview pages under /v4
# ALTHAIS_V4_PREVIEW=1

# Dental EMR vendors (dental_vendors.py). "mock" (the default) never sends anything. Claim.MD is built for both of these:
# DENTAL_VENDOR_CLEARINGHOUSE=claimmd    eligibility (270/271), 837D claims and predeterminations, ERAs (835)
# DENTAL_VENDOR_ATTACHMENTS=claimmd      X-rays, perio charts and narratives as one PDF after the claim
# CLAIMMD_TEST=1                         mark interchanges as test (ISA15 T) while trying a Claim.MD test account

# Open Dental live connection (opendental.py): Althais's developer key from Open Dental's developer portal
# OPENDENTAL_DEVELOPER_KEY=
# OPENDENTAL_BASE=https://api.opendental.com/api/v1
